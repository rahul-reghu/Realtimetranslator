<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-Time"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:letterSpacing="0.2"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Translator"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Mandarin ↔ English"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Permissions card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERMISSIONS"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="16dp"/>

            <!-- Mic row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:tint="@color/accent_blue"
                    android:padding="4dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/permission_microphone"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"/>

                <TextView
                    android:id="@+id/tvMicStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/not_granted"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/ivMicStatus"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:src="@android:drawable/presence_busy"/>
            </LinearLayout>

            <!-- Notif row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_dialog_info"
                    android:tint="@color/accent_blue"
                    android:padding="4dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/permission_notifications"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"/>

                <TextView
                    android:id="@+id/tvNotifStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/not_granted"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/ivNotifStatus"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:src="@android:drawable/presence_busy"/>
            </LinearLayout>

            <!-- Overlay row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="@color/accent_blue"
                    android:padding="4dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/permission_overlay"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"/>

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/not_granted"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/ivOverlayStatus"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:src="@android:drawable/presence_busy"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Grant buttons -->
        <Button
            android:id="@+id/btnRequestMic"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/grant_mic_notif"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:background="@drawable/bg_pill_glass"
            android:layout_marginBottom="8dp"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btnRequestOverlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/grant_overlay"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:background="@drawable/bg_pill_glass"
            android:layout_marginBottom="24dp"
            android:stateListAnimator="@null"/>

        <!-- Main start/stop button -->
        <Button
            android:id="@+id/btnStartStop"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/start_translator"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_pill_green"
            android:layout_marginBottom="12dp"
            android:stateListAnimator="@null"/>

        <!-- Settings -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚙  Settings"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:background="@drawable/bg_pill_glass"
            android:layout_marginBottom="20dp"
            android:stateListAnimator="@null"/>

        <!-- Status hint -->
        <TextView
            android:id="@+id/tvSetupHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/grant_permissions_hint"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.4"/>

    </LinearLayout>
</ScrollView>
