<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardOverlay"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/overlay_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <!-- Top bar: drag handle + controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <View
                android:id="@+id/dragHandle"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="#44FFFFFF"/>

            <ImageButton
                android:id="@+id/btnMinimize"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/arrow_up_float"
                android:tint="#88FFFFFF"
                android:background="@android:color/transparent"
                android:contentDescription="Minimize"
                android:layout_marginStart="8dp"/>

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/accent_red"
                android:background="@android:color/transparent"
                android:contentDescription="Close"
                android:layout_marginStart="2dp"/>
        </LinearLayout>

        <!-- Listen / Translate + swap in one row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnListenToggle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="▶ LISTEN"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_green"
                android:stateListAnimator="@null"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnSwapLanguage"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="ZH↔EN"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:background="@drawable/bg_pill_glass"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Live preview -->
        <TextView
            android:id="@+id/tvSourceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/listening"
            android:textColor="@color/text_secondary"
            android:textColorHint="@color/text_hint"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

        <!-- Translation -->
        <TextView
            android:id="@+id/tvTranslatedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.2"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <!-- TTS button -->
        <Button
            android:id="@+id/btnTts"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🔊 Speak"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:background="@drawable/bg_pill_blue"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:stateListAnimator="@null"
            android:visibility="gone"
            android:contentDescription="Speak translation"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
