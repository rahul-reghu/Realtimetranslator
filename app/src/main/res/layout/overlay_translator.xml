<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardOverlay"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#CC1A1A2E"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Drag Handle + top row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <View
                    android:id="@+id/dragHandle"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="#66FFFFFF" />

                <ImageButton
                    android:id="@+id/btnMinimize"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/arrow_up_float"
                    android:tint="#FFFFFF"
                    android:background="@android:color/transparent"
                    android:contentDescription="Minimize"
                    android:layout_marginStart="8dp" />

                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#FF6B6B"
                    android:background="@android:color/transparent"
                    android:contentDescription="Close"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- TAP TO LISTEN button — the main control -->
            <Button
                android:id="@+id/btnListenToggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="TAP TO LISTEN"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#FF2E7D32"
                android:layout_marginBottom="10dp" />

            <!-- Source Text (what was heard) -->
            <TextView
                android:id="@+id/tvSourceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/listening"
                android:textColor="#99FFFFFF"
                android:textColorHint="#66FFFFFF"
                android:textSize="12sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- Arrow -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="↓"
                android:textColor="#66FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <!-- Translated Text -->
            <TextView
                android:id="@+id/tvTranslatedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginBottom="8dp" />

            <!-- Bottom Row: TTS + Swap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnTts"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:tint="#FFFFFF"
                    android:background="@android:color/transparent"
                    android:contentDescription="Speak translation"
                    android:padding="8dp" />

                <ImageButton
                    android:id="@+id/btnSwapLanguage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:tint="#FFFFFF"
                    android:background="@android:color/transparent"
                    android:contentDescription="Swap language"
                    android:padding="8dp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvLanguageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZH → EN"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
