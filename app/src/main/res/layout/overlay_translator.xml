<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardOverlay"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#CC1A1A2E"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Drag Handle -->
            <View
                android:id="@+id/dragHandle"
                android:layout_width="30dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="#66FFFFFF"
                android:backgroundTint="#66FFFFFF" />

            <!-- Source Text (what was heard) -->
            <TextView
                android:id="@+id/tvSourceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/listening"
                android:textColor="#99FFFFFF"
                android:textColorHint="#66FFFFFF"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- Arrow -->
            <TextView
                android:id="@+id/tvArrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="→"
                android:textColor="#66FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <!-- Translated Text -->
            <TextView
                android:id="@+id/tvTranslatedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp" />

            <!-- Divider -->
            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginBottom="8dp" />

            <!-- Bottom Row Buttons -->
            <LinearLayout
                android:id="@+id/bottomRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- TTS Button -->
                <ImageButton
                    android:id="@+id/btnTts"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Speak translation"
                    android:padding="8dp" />

                <!-- Swap Language Button -->
                <ImageButton
                    android:id="@+id/btnSwapLanguage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Swap language direction"
                    android:padding="8dp" />

                <!-- Spacer -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Minimize Button -->
                <ImageButton
                    android:id="@+id/btnMinimize"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/arrow_up_float"
                    android:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Minimize"
                    android:padding="8dp" />

                <!-- Close Button -->
                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#FF6B6B"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close overlay"
                    android:padding="8dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
